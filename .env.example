NODE_ENV=development
HOST=127.0.0.1
PORT=3000
LOG_LEVEL=info
POSTGRES_USER=agentgate
POSTGRES_PASSWORD=local-development-only
POSTGRES_DB=agentgate
DATABASE_URL=postgresql://agentgate:local-development-only@localhost:5432/agentgate
JWT_ACCESS_SECRET=


# Phase B: fake lab only. Never enables real providers.
ACTION_ENVIRONMENT=development
FAKE_EXECUTION_ENABLED=false
FAKE_COMMERCE_SCENARIO=success

# Phase C: server-owned JSON rules; empty means no grants. Restart after changes.
POLICY_RULES_JSON=[]

# Phase F: optional per-organization/environment daily USD refund budgets.
# Minor units: 10000 USD cents = $100. All nodes must share this snapshot.
REFUND_BUDGETS_JSON=[]
