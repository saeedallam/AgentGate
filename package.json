{
  "name": "agentgate",
  "version": "1.0.0",
  "description": "Runtime action safety layer for AI agents: policies, approvals, safe execution, budgets and MCP",
  "main": "index.js",
  "scripts": {
    "test": "npm run build && node --test test/*.test.cjs",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/main.js",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:migrate": "prisma migrate dev",
    "lint": "eslint .",
    "mcp:start": "node dist/mcp/main.js",
    "observations:prune": "node scripts/prune-policy-studies.mjs",
    "audit:dependencies": "npm audit --audit-level=moderate"
  },
  "keywords": [],
  "author": "Saeed Allam",
  "license": "MIT",
  "type": "commonjs",
  "dependencies": {
    "@modelcontextprotocol/sdk": "1.32.1",
    "@nestjs/common": "11.2.5",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "11.2.5",
    "@nestjs/jwt": "11.0.2",
    "@nestjs/platform-fastify": "11.2.5",
    "@nestjs/throttler": "6.7.1",
    "@prisma/adapter-pg": "7.10.0",
    "@prisma/client": "7.10.0",
    "argon2": "0.45.1",
    "dotenv": "18.0.2",
    "pg": "8.23.0",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/node": "24.13.6",
    "@types/pg": "8.23.1",
    "eslint": "10.11.0",
    "jsdom": "30.1.3",
    "prisma": "7.10.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.2"
  },
  "private": true,
  "engines": {
    "node": ">=24.15.0 <25"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saeedallam/AgentGate.git"
  },
  "bugs": {
    "url": "https://github.com/saeedallam/AgentGate/issues"
  },
  "homepage": "https://github.com/saeedallam/AgentGate#readme",
  "overrides": {
    "@nestjs/platform-fastify": {
      "fastify": "5.12.7"
    },
    "@prisma/config": {
      "deepmerge-ts": "8.0.2"
    },
    "prisma": {
      "mysql2": "3.24.6"
    }
  }
}
