generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  MEMBER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String   @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  memberships OrganizationMember[]
}

enum ExecutionStatus {
  RECEIVED
  EXECUTING
  SUCCEEDED
  FAILED
  OUTCOME_UNKNOWN
}

enum ExecutionEnvironment {
  development
  staging
  production
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members OrganizationMember[]
  agents  Agent[]
}

model OrganizationMember {
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([organizationId, userId])
  @@index([userId])
}

model Agent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  name           String      @db.VarChar(100)
  status         AgentStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  credentials  AgentCredential[]
  executions   Execution[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
}

model AgentCredential {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  agentId        String    @db.Uuid
  keyPrefix      String    @unique @db.VarChar(64)
  keyHash        String    @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, agentId])
}

model Execution {
  id             String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  agentId        String @db.Uuid

  actionName String @db.VarChar(100)
  arguments  Json   @db.JsonB

  resourceType String? @db.VarChar(100)
  resourceId   String? @db.VarChar(256)

  environment ExecutionEnvironment
  status      ExecutionStatus      @default(RECEIVED)

  result    Json?   @db.JsonB
  errorCode String? @db.VarChar(100)

  requestedAt DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, agentId, createdAt])
}
