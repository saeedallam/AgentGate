generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  MEMBER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String   @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  memberships OrganizationMember[]
}

enum ExecutionStatus {
  RECEIVED
  EXECUTING
  SUCCEEDED
  FAILED
  OUTCOME_UNKNOWN
}

enum ExecutionEnvironment {
  development
  staging
  production
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members      OrganizationMember[]
  agents       Agent[]
  fakePayments FakePayment[]
}

model OrganizationMember {
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([organizationId, userId])
  @@index([userId])
}

model Agent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  name           String      @db.VarChar(100)
  status         AgentStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  credentials  AgentCredential[]
  executions   Execution[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
}

model AgentCredential {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  agentId        String    @db.Uuid
  keyPrefix      String    @unique @db.VarChar(64)
  keyHash        String    @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, agentId])
}

model Execution {
  idempotencyKey String?            @db.VarChar(128)
  requestHash    String?            @db.VarChar(64)
  attempts       ExecutionAttempt[]
  id             String             @id @default(uuid()) @db.Uuid
  organizationId String             @db.Uuid
  agentId        String             @db.Uuid

  actionName String @db.VarChar(100)
  arguments  Json   @db.JsonB

  resourceType String? @db.VarChar(100)
  resourceId   String? @db.VarChar(256)

  environment ExecutionEnvironment
  status      ExecutionStatus      @default(RECEIVED)

  result    Json?   @db.JsonB
  errorCode String? @db.VarChar(100)

  requestedAt DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, agentId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([organizationId, agentId, createdAt])
}

model ExecutionAttempt {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  executionId    String          @unique @db.Uuid
  credentialId   String          @db.Uuid
  status         ExecutionStatus @default(EXECUTING)
  startedAt      DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?       @db.Timestamptz(3)
  errorCode      String?         @db.VarChar(100)
  execution      Execution       @relation(fields: [organizationId, executionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
}

// Test lab only. Seeded by an operator; never created from agent input.
model FakePayment {
  organizationId    String       @db.Uuid
  id                String       @db.VarChar(128)
  amountMinor       Int
  currency          String       @default("USD") @db.VarChar(3)
  refunded          Boolean      @default(false)
  refundExecutionId String?      @unique @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
}
