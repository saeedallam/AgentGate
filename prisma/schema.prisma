generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

enum OrganizationRole {
  OWNER
  MEMBER
}

enum AgentStatus {
  ACTIVE
  SUSPENDED
}

model User {
  id           String   @id @default(uuid()) @db.Uuid
  email        String   @unique @db.VarChar(320)
  passwordHash String   @db.Text
  createdAt    DateTime @default(now()) @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @db.Timestamptz(3)

  policyStudies PolicyStudy[]
  memberships       OrganizationMember[]
  approvalDecisions Approval[]
}

enum ExecutionStatus {
  DENIED
  RECEIVED
  EXECUTING
  SUCCEEDED
  FAILED
  OUTCOME_UNKNOWN
}

enum ExecutionEnvironment {
  development
  staging
  production
}

model Organization {
  id        String   @id @default(uuid()) @db.Uuid
  name      String   @db.VarChar(120)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  updatedAt DateTime @updatedAt @db.Timestamptz(3)

  members      OrganizationMember[]
  agents       Agent[]
  fakePayments FakePayment[]
  refundBudgetBuckets RefundBudgetBucket[]
  policyStudies PolicyStudy[]
}

model OrganizationMember {
  organizationId String           @db.Uuid
  userId         String           @db.Uuid
  role           OrganizationRole @default(MEMBER)
  createdAt      DateTime         @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime         @updatedAt @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@id([organizationId, userId])
  @@index([userId])
}

model Agent {
  id             String      @id @default(uuid()) @db.Uuid
  organizationId String      @db.Uuid
  name           String      @db.VarChar(100)
  status         AgentStatus @default(ACTIVE)
  createdAt      DateTime    @default(now()) @db.Timestamptz(3)
  updatedAt      DateTime    @updatedAt @db.Timestamptz(3)

  organization Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  credentials  AgentCredential[]
  executions   Execution[]
  policyStudies PolicyStudy[]

  @@unique([organizationId, name])
  @@unique([organizationId, id])
}

model AgentCredential {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @db.Uuid
  agentId        String    @db.Uuid
  keyPrefix      String    @unique @db.VarChar(64)
  keyHash        String    @db.Text
  createdAt      DateTime  @default(now()) @db.Timestamptz(3)
  revokedAt      DateTime? @db.Timestamptz(3)

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@index([organizationId, agentId])
}

enum PolicyDecision {
  ALLOW
  DENY
  REQUIRE_APPROVAL
}

model Execution {
  recoveryVersion Int @default(0)
  attemptCount Int @default(0)
  leaseExpiresAt DateTime? @db.Timestamptz(3)
  nextRetryAt DateTime? @db.Timestamptz(3)
  providerReceipt FakeProviderReceipt?
  refundBudgetReservation RefundBudgetReservation?
  blockedPolicyDecision PolicyDecision?
  blockedPolicyHash String? @db.VarChar(64)
  blockedAt DateTime? @db.Timestamptz(3)
  policyDecision    PolicyDecision?
  policyReason      String?            @db.VarChar(100)
  policyHash        String?            @db.VarChar(64)
  policyEvaluatedAt DateTime?          @db.Timestamptz(3)
  idempotencyKey    String?            @db.VarChar(128)
  requestHash       String?            @db.VarChar(64)
  attempts          ExecutionAttempt[]
  approval          Approval?
  id                String             @id @default(uuid()) @db.Uuid
  organizationId    String             @db.Uuid
  agentId           String             @db.Uuid

  actionName String @db.VarChar(100)
  arguments  Json   @db.JsonB

  resourceType String? @db.VarChar(100)
  resourceId   String? @db.VarChar(256)

  environment ExecutionEnvironment
  status      ExecutionStatus      @default(RECEIVED)

  result    Json?   @db.JsonB
  errorCode String? @db.VarChar(100)

  requestedAt DateTime @db.Timestamptz(3)
  createdAt   DateTime @default(now()) @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @db.Timestamptz(3)

  agent Agent @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, agentId, idempotencyKey])
  @@unique([organizationId, id])
  @@index([organizationId, agentId, createdAt])
}

model ExecutionAttempt {
  id             String          @id @default(uuid()) @db.Uuid
  organizationId String          @db.Uuid
  executionId    String          @db.Uuid
  attemptNumber Int @default(1)
  resolvedAt DateTime? @db.Timestamptz(3)
  resolvedStatus ExecutionStatus?
  credentialId   String          @db.Uuid
  status         ExecutionStatus @default(EXECUTING)
  startedAt      DateTime        @default(now()) @db.Timestamptz(3)
  finishedAt     DateTime?       @db.Timestamptz(3)
  errorCode      String?         @db.VarChar(100)
  execution      Execution       @relation(fields: [organizationId, executionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  @@unique([executionId, attemptNumber])
}

// Test lab only. Seeded by an operator; never created from agent input.
model FakePayment {
  organizationId    String       @db.Uuid
  id                String       @db.VarChar(128)
  amountMinor       Int
  currency          String       @default("USD") @db.VarChar(3)
  refunded          Boolean      @default(false)
  refundExecutionId String?      @unique @db.Uuid
  organization      Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@id([organizationId, id])
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

model Approval {
  id              String         @id @default(uuid()) @db.Uuid
  organizationId  String         @db.Uuid
  executionId     String         @unique @db.Uuid
  requestHash     String         @db.VarChar(64)
  status          ApprovalStatus @default(PENDING)
  decidedByUserId String?        @db.Uuid
  decidedAt       DateTime?      @db.Timestamptz(3)
  createdAt       DateTime       @default(now()) @db.Timestamptz(3)
  updatedAt       DateTime       @updatedAt @db.Timestamptz(3)

  execution Execution @relation(fields: [organizationId, executionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  decidedBy User?     @relation(fields: [decidedByUserId], references: [id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([organizationId, executionId])
  @@index([organizationId, status, createdAt])
  @@index([decidedByUserId])
}

// Fake provider-owned journal. Its commit is atomic with the simulated effect.
model FakeProviderReceipt {
  executionId String @id @db.Uuid
  organizationId String @db.Uuid
  requestHash String @db.VarChar(64)
  outcome Json? @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  execution Execution @relation(fields: [organizationId, executionId], references: [organizationId, id], onDelete: Cascade, onUpdate: Restrict)
  @@unique([organizationId, executionId])
}

// Scope is organization + execution environment + currency + first-dispatch UTC day.
model RefundBudgetBucket {
  organizationId String @db.Uuid
  environment ExecutionEnvironment
  currency String @db.VarChar(3)
  day DateTime @db.Date
  limitMinor Int
  reservedMinor Int @default(0)
  consumedMinor Int @default(0)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  reservations RefundBudgetReservation[]
  @@id([organizationId, environment, currency, day])
}

enum RefundReservationStatus {
  HELD
  CONSUMED
  RELEASED
}

model RefundBudgetReservation {
  executionId String @id @db.Uuid
  organizationId String @db.Uuid
  environment ExecutionEnvironment
  currency String @db.VarChar(3)
  day DateTime @db.Date
  amountMinor Int
  status RefundReservationStatus @default(HELD)
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  settledAt DateTime? @db.Timestamptz(3)
  execution Execution @relation(fields: [organizationId, executionId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  bucket RefundBudgetBucket @relation(fields: [organizationId, environment, currency, day], references: [organizationId, environment, currency, day], onDelete: Restrict, onUpdate: Restrict)
  @@unique([organizationId, executionId])
  @@index([organizationId, environment, currency, day])
}

// Redacted policy-only evidence. Never an execution, approval or authorization token.
enum PolicyStudyMode {
  OBSERVE
  SIMULATE
}
model PolicyStudy {
  id String @id @default(uuid()) @db.Uuid
  organizationId String @db.Uuid
  agentId String? @db.Uuid
  userId String? @db.Uuid
  mode PolicyStudyMode
  policyHash String @db.VarChar(64)
  summary Json @db.JsonB
  results Json @db.JsonB
  createdAt DateTime @default(now()) @db.Timestamptz(3)
  expiresAt DateTime @db.Timestamptz(3)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  agent Agent? @relation(fields: [organizationId, agentId], references: [organizationId, id], onDelete: Restrict, onUpdate: Restrict)
  user User? @relation(fields: [userId], references: [id], onDelete: Restrict)
  @@index([organizationId, createdAt, id])
  @@index([expiresAt])
}
